generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Used at runtime

  directUrl = env("DIRECT_URL") // Used by CLI commands like migrate
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String
  blogs    Blog[]
}

model Blog {
  id        String  @id @default(uuid())
  title     String
  content   String
  published Boolean @default(false)
  author    User    @relation(fields: [authorId], references: [id])
  authorId  String
}
